[36m(WorkerDict pid=850482)[0m +                ]
[36m(WorkerDict pid=850482)[0m +                or (
[36m(WorkerDict pid=850482)[0m +                    name in inherent_attributes
[36m(WorkerDict pid=850482)[0m +                    and compare(inherent_attributes[name](user), value)
[36m(WorkerDict pid=850482)[0m +                )
[36m(WorkerDict pid=850482)[0m +            ]
[36m(WorkerDict pid=850482)[0m +        response: Dict[str, Any] = {
