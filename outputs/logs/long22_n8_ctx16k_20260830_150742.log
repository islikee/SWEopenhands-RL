[36m(WorkerDict pid=850482)[0m +                "cognito:user_status",
[36m(WorkerDict pid=850482)[0m +                "status",
[36m(WorkerDict pid=850482)[0m +                "sub",
[36m(WorkerDict pid=850482)[0m +            ]
[36m(WorkerDict pid=850482)[0m +
[36m(WorkerDict pid=850482)[0m +            match = re.match(r"([\w:]+)\s*(=|\^=)\s*\"(.*)\"", filt)
[36m(WorkerDict pid=850482)[0m +            if match:
