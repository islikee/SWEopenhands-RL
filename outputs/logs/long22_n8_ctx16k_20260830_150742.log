[36m(WorkerDict pid=850482)[0m +            }
[36m(WorkerDict pid=850482)[0m +            allowed_attributes = [
[36m(WorkerDict pid=850482)[0m +                "username",
[36m(WorkerDict pid=850482)[0m +                "email",
[36m(WorkerDict pid=850482)[0m +                "phone_number",
[36m(WorkerDict pid=850482)[0m +                "name",
