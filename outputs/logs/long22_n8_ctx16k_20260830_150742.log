[36m(WorkerDict pid=850482)[0m +            compare = comparisons[op]
[36m(WorkerDict pid=850482)[0m +            users = [
[36m(WorkerDict pid=850482)[0m +                user
[36m(WorkerDict pid=850482)[0m +                for user in users
